---
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";
import Analytics from "../components/Analytics.astro";
import PostHog from "../components/PostHog.astro";
import { siteConfig } from "../config/site";
import { truncateText } from "../lib/seo";

interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
    showHeader?: boolean;
    showFooter?: boolean;
    currentPath?: string;
    /** Set false when the page provides a fully-formed title (no brand suffix). */
    suffixTitle?: boolean;
}

const {
    title = siteConfig.name,
    description = siteConfig.description,
    ogImage,
    showHeader = true,
    showFooter = true,
    currentPath = "/",
    suffixTitle = true,
} = Astro.props;

let fullTitle;
if (!suffixTitle || title === siteConfig.name) {
    fullTitle = title;
} else {
    fullTitle = `${title} — ${siteConfig.name}`;
}

const metaDescription = truncateText(description, 160);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        <meta name="description" content={metaDescription} />
        <link rel="canonical" href={Astro.url?.toString()} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />

        <SeoHead title={fullTitle} description={description} ogImage={ogImage} />

        {currentPath.replace(/\/$/, "") === "/recent" && (
            <link
                rel="alternate"
                type="application/atom+xml"
                title="Pardonned — Recent Clemency Grants"
                href={`${siteConfig.siteUrl}/recent.xml`}
            />
        )}

        <!-- Self-hosted fonts (Astro Fonts API) - DM Sans + DM Serif Display -->
        <Font cssVariable="--font-dm-sans" preload />
        <Font cssVariable="--font-dm-serif-display" preload />

        <Analytics />
        <PostHog />
    </head>
    <body
        class="bg-page font-sans text-body antialiased min-h-screen flex flex-col"
    >
        <a href="#main-content" class="skip-link">Skip to content</a>
        {showHeader && <Header currentPath={currentPath} />}

        <main id="main-content" class="flex-1">
            <slot />
        </main>

        {showFooter && <Footer />}
    </body>
</html>
